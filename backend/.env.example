# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fitness_app
DB_USER=root
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_secure
JWT_EXPIRE=7d

# Server Configuration
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000/api

# OpenAI API (Optional - for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Cloudinary (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (Optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Firebase (Optional - for push notifications)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# External APIs (Optional)
NUTRITION_API_KEY=your_nutrition_api_key
WEATHER_API_KEY=your_weather_api_key

VIDEO_UPLOAD_MAX_MB=500

# CORS Configuration
# Production CORS origins (comma-separated)
CORS_ORIGIN_PROD=https://yourdomain.com
# Development CORS origins (comma-separated)
CORS_ORIGIN_DEV=http://localhost:3000,http://localhost:8081

# Socket.IO Configuration
# Production Socket.IO origins (comma-separated)
SOCKET_ORIGIN_PROD=https://yourdomain.com
# Development Socket.IO origins (comma-separated)
SOCKET_ORIGIN_DEV=http://localhost:3000,http://192.168.1.28:8081,http://localhost:19006
